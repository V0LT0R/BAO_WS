{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bao-cv",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://bao-cv.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bao-cv",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "MEDIA" }],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "AuthService" },
      { "name": "CONTENT_WRITER", "class_name": "ContentWriter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthService", "ContentWriter"] }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
