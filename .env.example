NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bao_local
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:5000
# Set 1 only when the app is behind exactly one trusted reverse proxy (e.g. Render).
TRUST_PROXY=0
# Optional process-only DNS resolver override, useful if local SRV lookups fail.
DNS_SERVERS=
# Optional replacement key, obtained after revoking the previously public key.
SCOPUS_API_KEY=
# Build-time canonical domain. Never put secrets in VITE_* environment variables.
SITE_URL=https://bao-cv.com
